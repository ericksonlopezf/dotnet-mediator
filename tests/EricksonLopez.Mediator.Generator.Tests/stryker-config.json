{
  "stryker-config": {
    "project": "EricksonLopez.Mediator.Generator.csproj",
    "concurrency": 1,
    "coverage-analysis": "perTest",
    "additional-timeout": 30000,
    "thresholds": {
      "high": 100,
      "low": 95,
      "break": 90
    },
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "Dispose"
    ]
  }
}

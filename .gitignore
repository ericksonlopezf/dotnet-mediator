# =============================================================================
# EricksonLopez.Mediator .gitignore
# Optimized for .NET 10, C# 14, Roslyn Incremental Generators, Native AOT,
# BenchmarkDotNet, Stryker.NET Mutation Testing, and Multi-Platform Environments.
# =============================================================================

# ─── .NET Build & Compilation Outputs ─────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Aa]rtifacts/
out/
bld/
publish/
[Bb]uild[Ll]og.*
*.log
*.binlog
msbuild.binlog
msbuild.rsp
!Directory.Build.rsp

# ─── Roslyn Incremental Source Generator Outputs ─────────────────────────────
# Emitted compiler files when EmitCompilerGeneratedFiles is enabled
Generated/
[Gg]enerated/
*.generated.cs
*.g.cs

# ─── NuGet Packaging ─────────────────────────────────────────────────────────
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# ─── Testing, Code Coverage & Mutation Gates ─────────────────────────────────
[Tt]est[Rr]esults/
test-results/
[Tt]est[Rr]esult*/
TestResult.xml
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
coveragereport/
StrykerOutput/
stryker_trace.txt

# ─── BenchmarkDotNet & Performance Artifacts ─────────────────────────────────
BenchmarkDotNet.Artifacts/

# ─── Native AOT, Cross-Compilation & Native Binaries ──────────────────────────
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
*.ilk
*.pdb
*.iobj
*.ipdb
*.pch
*.lib
*.exp
*.dSYM/

# ─── Visual Studio / MSBuild User Settings ───────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# ─── Visual Studio Code ───────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── JetBrains Rider & ReSharper ─────────────────────────────────────────────
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper

# ─── Operating Systems & Shells ───────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# Linux
*~
*.swp
*.swo
.fuse_hidden*

# ─── Environment, Secrets & Local Overrides ───────────────────────────────────
.env
.env.*
!.env.example
*.pfx
*.publishsettings

# Keep repository signing key tracked
!EricksonLopez.snk

# ─── Local Scratch & Temporary Workspace ──────────────────────────────────────
scratch/
temp/
tmp/
*.tmp
